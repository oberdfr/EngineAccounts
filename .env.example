# EngineAccounts ONLY. Copy to .env at the root of this repository.
# Node 24 + PostgreSQL + reachable SMTP required. DNS/TLS are external prerequisites.
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8080
OIDC_ISSUER=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
TRUST_PROXY=false
DATABASE_URL=postgres://engine:CHANGE_ME@127.0.0.1:55432/engine
DB_SCHEMA=engine_accounts
DB_POOL_MAX=10
DB_SSL=false
OIDC_AUDIENCE=https://api.engine.local/streaming
# Stable secrets: openssl rand -base64 48 (each independently).
# Event root also configured in the consumer; data key is HKDF-derived by default.
OIDC_EVENT_SIGNING_SECRET=
ENGINE_ACCOUNTS_COOKIE_SECRET=
# Optional explicit data key. Do not change derivation/key on existing data.
# ENGINE_ACCOUNTS_DATA_KEY=
ENGINE_ACCOUNTS_JWKS_PATH=var/jwks.json
COOKIE_HOST_PREFIX=false
# COOKIE_SECURE defaults to true when OIDC_ISSUER is HTTPS.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
# Public clients bootstrapped before the OIDC provider starts. One JSON line,
# exact callback/logout URLs, no wildcards. [] runs Accounts without consumers.
# Change the URLs/audience consistently in the StreamingEngine .env too.
OIDC_CLIENTS_JSON='[{"clientId":"streamingengine-web","clientName":"StreamingEngine Web","redirectUris":["http://localhost:5173/auth/callback"],"postLogoutRedirectUris":["http://localhost:5173/"],"audience":"https://api.engine.local/streaming","scope":["openid","profile","email","offline_access","streaming:catalog","streaming:playback","streaming:account"],"backchannelEventsUri":"http://127.0.0.1:8081/internal/events/account-deleted"}]'
# Only on a deliberately trusted private HTTP network; otherwise HTTPS.
BACKCHANNEL_HTTP_ALLOWED_ORIGINS=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
ID_TOKEN_TTL=900
PASSWORD_RESET_TTL=900
EMAIL_VERIFICATION_TTL=900
EMAIL_CHANGE_TTL=900
MAGIC_CODE_TTL=300
SESSION_TTL=1209600
CONSENT_TTL=31536000
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=1024
HTTP_LOGIN_SLOW_MS=200
HIBP_ENABLED=true
HIBP_API_BASE=https://api.pwnedpasswords.com
HIBP_TIMEOUT_MS=1500
HIBP_CACHE_TTL_MS=86400000
MAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME="Engine Accounts"
SMTP_SECURE=false
# Compose bindings; use container-reachable DATABASE_URL and SMTP_HOST in Compose.
BIND_ADDRESS=127.0.0.1
