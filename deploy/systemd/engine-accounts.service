[Unit]
Description=EngineAccounts independent OIDC identity provider
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/root/EngineAccounts
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -f /root/EngineAccounts/dist/server.js
ExecStart=/usr/bin/node --env-file=/root/EngineAccounts/.env dist/server.js
ExecStartPost=/root/EngineAccounts/scripts/ready.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=200
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
UMask=0027
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
