{
  "name": "@engine/accounts",
  "version": "1.0.0",
  "private": true,
  "description": "EngineAccounts — independent OIDC identity provider and account management",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli/main.ts",
    "e2e:http": "node scripts/http-e2e.mjs",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@epic-web/totp": "^4.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.13",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.9",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
